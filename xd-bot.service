[Unit]
Description=XD Downloader Bot (yt-dlp Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xd-downloader
Environment=XD_BOT_TOKEN=8903556855:CHANGE_ME
Environment=ALLOWED_USER_ID=5669842121
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python3 /root/xd-downloader/bot.py
Restart=always
RestartSec=10
MemoryMax=400M

[Install]
WantedBy=multi-user.target